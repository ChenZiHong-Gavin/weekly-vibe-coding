# Copy to .env. Values stay on the local Node server and are never sent to the browser.
# Provider A: Volcengine Ark / Doubao (takes precedence when set)
ARK_API_KEY=
DOUBAO_MODEL=doubao-seed-evolving
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Provider B: Anthropic
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=
PORT=4319
